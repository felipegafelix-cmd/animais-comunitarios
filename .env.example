# ==============================================================================
# Supabase - Configurações do Cliente e Banco de Dados
# Copie este arquivo para .env.local e preencha com seus valores.
# ==============================================================================

# URL do seu projeto (ex: https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon key) segura para usar no cliente (browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: URL direta de conexão com o banco de dados (ex: postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres)
# Usado por ORMs, mas não é estritamente necessário apenas para o @supabase/ssr.
# DATABASE_URL=
